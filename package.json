    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mime-types": "^3.0.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "sanitize-filename": "^1.6.3",
    "google-play-scraper": "^10.1.0",
    "@hapi/boom": "^10.0.1"
  }
}
