{
  "name": "beautxie-ai-media-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone BEAUTXIE AI WhatsApp media downloader and group-management bot.",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
